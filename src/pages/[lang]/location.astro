---
import Base from '@/layouts/Base.astro'
import { Icon } from 'astro-icon/components'
import { content, defaultLang, eventLinks, isLang, localizedStaticPaths, type Lang } from '@/lib/astro/i18n'

export const getStaticPaths = localizedStaticPaths

const lang = isLang(Astro.params.lang) ? (Astro.params.lang as Lang) : defaultLang
const t = content[lang]

const lecceMapsUrl = eventLinks.directions
const lecceOpenStreetMap =
    'https://www.openstreetmap.org/export/embed.html?bbox=18.1585%2C40.3538%2C18.1735%2C40.3628&layer=mapnik&marker=40.35826%2C18.16623'
---

<Base lang={lang} title={t.location.title}>
    <section id="location-hero">
        <div class="location-hero-content">
            <div class="location-text-container">
                <div class="location-text">
                    <h1>{t.location.heroTitle}</h1>
                    <p class="location-subtitle">{t.location.subtitle}</p>
                    <div class="location-badge">
                        <Icon name="mdi:map-marker" />
                        <div class="badge-text">
                            <h3>{t.location.venueName}</h3>
                            <p>{t.location.venueAddress}</p>
                        </div>
                    </div>
                    <a
                        class="primary large"
                        href={lecceMapsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        role="button"
                    >
                        <Icon name="mdi:map-search" />
                        {t.location.mapCta}
                    </a>
                </div>
            </div>
            <div class="location-visual">
                <div class="location-map-preview">
                    <iframe title={t.location.mapTitle} src={lecceOpenStreetMap} loading="lazy"></iframe>
                    <div class="map-preview-chip">
                        <Icon name="mdi:map-marker" />
                        <span>{t.location.venueName}</span>
                    </div>
                    <a
                        class="map-preview-link button square"
                        href={lecceMapsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={t.location.mapCta}
                    >
                        <Icon name="mdi:open-in-new" />
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section id="location-info">
        <h2>{t.location.infoTitle}</h2>
        <div class="location-info-layout">
            <div class="card large location-info-card">
                <div class="text">
                    {t.location.info.map(paragraph => <p>{paragraph}</p>)}
                </div>
            </div>
            <div class="location-highlight-list">
                {
                    t.location.venueHighlights.map(highlight => (
                        <div class="card location-highlight-card">
                            <Icon name="mdi:map-marker-radius-outline" />
                            <div class="text">
                                <h3>{highlight.title}</h3>
                                <p>{highlight.text}</p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section id="location-indoor-map">
        <div class="section-heading">
            <h2>{t.location.indoor.title}</h2>
            <p>{t.location.indoor.subtitle}</p>
        </div>
        <div class="indoor-map-layout">
            <div class="indoor-map-board">
                <div class="indoor-map-floor" aria-label={t.location.indoor.title}>
                    <div class="indoor-entrance">
                        <Icon name="mdi:login" />
                        {t.location.indoor.entrance}
                    </div>
                    <div class="indoor-corridor">{t.location.indoor.corridor}</div>
                    {
                        t.location.indoor.rooms.map((room, index) => (
                            <button
                                type="button"
                                class:list={['indoor-map-room', index === 0 && 'is-active']}
                                style={`--x: ${room.x}; --y: ${room.y}; --w: ${room.w}; --h: ${room.h}; --accent: ${room.accent};`}
                                data-room-id={room.id}
                                aria-pressed={index === 0 ? 'true' : 'false'}
                                aria-controls={`indoor-room-${room.id}`}
                            >
                                <strong>{room.label}</strong>
                                <span>{room.room}</span>
                            </button>
                        ))
                    }
                </div>
            </div>
            <div class="indoor-room-list" aria-live="polite">
                <h3>{t.location.indoor.detailsTitle}</h3>
                {
                    t.location.indoor.rooms.map((room, index) => (
                        <article
                            id={`indoor-room-${room.id}`}
                            class:list={['indoor-room-card', index === 0 && 'is-active']}
                            style={`--accent: ${room.accent};`}
                            data-room-card={room.id}
                        >
                            <span>{room.track}</span>
                            <h4>{room.room}</h4>
                            <p>{room.description}</p>
                        </article>
                    ))
                }
                <p class="indoor-map-note">{t.location.indoor.note}</p>
            </div>
        </div>
        <script>
            const indoorRoomButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.indoor-map-room'))
            const indoorRoomCards = Array.from(document.querySelectorAll<HTMLElement>('.indoor-room-card'))

            const setActiveIndoorRoom = (roomId: string) => {
                indoorRoomButtons.forEach(button => {
                    const isActive = button.dataset.roomId === roomId
                    button.classList.toggle('is-active', isActive)
                    button.setAttribute('aria-pressed', String(isActive))
                })

                indoorRoomCards.forEach(card => {
                    card.classList.toggle('is-active', card.dataset.roomCard === roomId)
                })
            }

            indoorRoomButtons.forEach(button => {
                button.addEventListener('click', () => {
                    const roomId = button.dataset.roomId

                    if (roomId) {
                        setActiveIndoorRoom(roomId)
                    }
                })
            })
        </script>
    </section>

    <section id="location-directions">
        <div class="section-heading">
            <span class="section-kicker">{t.location.findUs}</span>
            <div class="text">
                <h2>{t.location.directionsTitle}</h2>
                <p>{t.location.directionsIntro}</p>
            </div>
        </div>
        <div class="directions-list">
            {
                t.location.directions.map(direction => (
                    <div class="card large direction-card">
                        <Icon name={direction.icon} />
                        <div class="text">
                            <h3>{direction.title}</h3>
                            <p>{direction.text}</p>
                            <ul>
                                {direction.details.map(detail => (
                                    <li>{detail}</li>
                                ))}
                            </ul>
                        </div>
                        <a class="large" href={direction.href} target="_blank" rel="noopener noreferrer" role="button">
                            <Icon name="mdi:open-in-new" />
                            {direction.cta}
                        </a>
                    </div>
                ))
            }
        </div>
    </section>
</Base>
