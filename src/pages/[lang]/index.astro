---
import Base from '@/layouts/Base.astro'
import { Icon } from 'astro-icon/components'

import HomepageGallery from '@/components/astro/HomepageGallery.astro'
import devfestLogoSvg from '@/assets/devfest-logo.svg'
import { sponsorTierOrder, sponsors } from '@/assets/data-sponsors'
import {
    content,
    defaultLang,
    eventFeatureFlags,
    eventLinks,
    isLang,
    localizedStaticPaths,
    routePath,
    type Lang,
} from '@/lib/astro/i18n'

export const getStaticPaths = localizedStaticPaths

const lang = isLang(Astro.params.lang) ? (Astro.params.lang as Lang) : defaultLang
const t = content[lang]
const showCallForSpeakers = eventFeatureFlags.showCallForSpeakers
const sponsorSections = sponsorTierOrder
    .map(tier => ({
        tier,
        label: t.home.sponsors.tierLabels[tier],
        items: sponsors[tier],
    }))
    .filter(section => section.items.length > 0)
const hasSponsors = sponsorSections.length > 0
---

<Base lang={lang}>
    <section id="hero">
        <div id="binary-art"></div>
        <div class="h-stack home-hero-layout">
            <div class="hero-content v-stack">
                <div class="text">
                    <p class="motto">{t.home.heroEyebrow}</p>
                    <h1>{t.home.heroTitle}</h1>
                    <h3>{t.home.heroSubtitle}</h3>
                    <div class="hero-meta h-flex-wrap" aria-label={`${t.home.heroDate}, ${t.home.heroLocation}`}>
                        <span>
                            <Icon name="mdi:calendar-month-outline" />
                            {t.home.heroDate}
                        </span>
                        <span>
                            <Icon name="mdi:map-marker-outline" />
                            {t.home.heroLocation}
                        </span>
                    </div>
                </div>
                <div class="hero-actions h-flex-wrap">
                    <a
                        class="primary large"
                        href={eventLinks.gdg}
                        target="_blank"
                        rel="noopener noreferrer"
                        role="button"
                    >
                        <Icon name="mdi:bell-outline" />
                        {t.home.primaryCta}
                    </a>
                    {
                        showCallForSpeakers && (
                            <a
                                class="large"
                                href={eventLinks.cfp}
                                target="_blank"
                                rel="noopener noreferrer"
                                role="button"
                            >
                                <Icon name="mdi:microphone-outline" />
                                {t.home.secondaryCta}
                            </a>
                        )
                    }
                </div>
            </div>
            <img class="hero-image hero-logo" src={devfestLogoSvg.src} alt={t.site.title} />
        </div>
        <script>
            import { BinaryGrid } from '@/lib/client/binary-art-10y'
            const $binaryArtContainer = document.getElementById('binary-art')!
            new BinaryGrid($binaryArtContainer, {
                cellSize: 32,
                fontSize: 16,
                fontFamily: "'Roboto Mono', 'Courier New', monospace",
                updateInterval: 10,
                samplingRate: 0.005,
                colors: {
                    base: '#7cbdff',
                    bg: '#a5d2ff',
                    highlight: '#579ee5',
                },
            })
        </script>
    </section>

    <section id="tickets">
        <h2>{t.home.tickets.title}</h2>
        <div class="card large">
            <div class="text">
                <p>{t.home.tickets.subtitle}</p>
            </div>
            <a class="large" href={eventLinks.gdg} target="_blank" rel="noopener noreferrer" role="button">
                <Icon name="mdi:account-group" />
                {t.home.tickets.cta}
            </a>
        </div>
    </section>

    {
        showCallForSpeakers && (
            <section id="cfp">
                <h2>{t.home.cfp.title}</h2>
                <div class="card large">
                    <div class="text">
                        <p>{t.home.cfp.subtitle}</p>
                    </div>
                    <a
                        class="large primary"
                        href={eventLinks.cfp}
                        target="_blank"
                        rel="noopener noreferrer"
                        role="button"
                    >
                        <Icon name="mdi:microphone-outline" />
                        {t.home.cfp.cta}
                    </a>
                </div>
            </section>
        )
    }

    <section id="stats">
        <div class="stats-layouts">
            <div class="stats-card card large">
                <div class="text">
                    <h2>{t.home.announcementTitle}</h2>
                    <p>{t.home.announcementText}</p>
                    <p class="stats-kicker">{t.home.statsIntro}</p>
                </div>
                <a class="large" href={routePath(lang, 'about')} role="button">
                    <Icon name="material-symbols:groups-rounded" />
                    {t.nav.about}
                </a>
            </div>
            <div class="stats-grid">
                {
                    t.home.stats.map(stat => (
                        <div class="card large">
                            <div class="v-stack center">
                                <div class="text-large">{stat.value}</div>
                                <div class="text-center">{stat.label}</div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <HomepageGallery title={t.home.gallery.title} intro={t.home.gallery.intro} />

    <section id="sponsors">
        <h2>{t.home.sponsors.title}</h2>
        <div class="sponsor-layout sponsor-logo-layout">
            <div class="sponsor-logo-area">
                <h3>{t.home.sponsors.logoTitle}</h3>
                {
                    hasSponsors ? (
                        sponsorSections.map(section => (
                            <div class="sponsor-logo-tier">
                                <h4>{section.label}</h4>
                                <div class="small-card-list h-flex-wrap">
                                    {section.items.map(sponsor =>
                                        sponsor.url ? (
                                            <a
                                                class="card sponsor-logo-card"
                                                href={sponsor.url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            >
                                                <img src={sponsor.logo.src} alt={sponsor.name} />
                                            </a>
                                        ) : (
                                            <div class="card sponsor-logo-card">
                                                <img src={sponsor.logo.src} alt={sponsor.name} />
                                            </div>
                                        ),
                                    )}
                                </div>
                            </div>
                        ))
                    ) : (
                        <div class="card large sponsor-logo-placeholder">{t.home.sponsors.logoEmpty}</div>
                    )
                }
            </div>
        </div>
    </section>
</Base>
