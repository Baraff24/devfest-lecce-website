---
import Base from '@/layouts/Base.astro'
import devfestLogoSvg from '@/assets/devfest-logo.svg'
import { content, getLangFromUrl, routePath } from '@/lib/astro/i18n'

const lang = getLangFromUrl(Astro.url)
const t = content[lang]
---

<style>
    body {
        background: linear-gradient(to right, #f0f2f5 45%, #fff);
    }

    .hero-404-section {
        background: linear-gradient(to right, #f0f2f5 45%, #fff) !important;
        display: flex;
        align-items: center;
    }

    .h-stack-404 {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        gap: 4rem;
        position: relative;
        padding-bottom: 4rem;
    }

    @media (max-width: 768px) {
        .h-stack-404 {
            flex-direction: column;
            justify-content: center;
            gap: 3rem;
            padding-bottom: 2rem;
            padding-top: 2rem;
        }

        .code-block {
            font-size: 0.95rem;
        }

        .code-block .indent {
            padding-left: 1rem;
        }
    }

    .content-wrapper {
        z-index: 2;
        flex: 2;
        max-width: 900px;
    }

    .title-text {
        text-shadow: none !important;
    }

    .title-text h1 {
        font-size: clamp(4rem, 8vw, 6rem);
        margin-bottom: 0;
        line-height: 1.1;
    }

    .title-text h3 {
        margin-top: 0;
        color: #333;
    }

    .exception-card {
        align-items: flex-start;
        text-align: left;
        background: #fff;
    }

    .code-block {
        font-family: 'Roboto Mono', Courier, monospace;
        margin-bottom: 1.5rem;
        width: 100%;
        text-shadow: none !important;
        font-size: 1.15rem;
        line-height: 1.6;
        background: transparent;
        padding: 0;
        border: none;
        white-space: pre-wrap;
    }

    .code-block .indent {
        padding-left: 2rem;
    }

    .code-block .kw {
        color: var(--core-blue);
        font-weight: bold;
    }

    .code-block .str {
        color: var(--red-500);
    }

    .action-button {
        font-family: 'Roboto Mono', Courier, monospace;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 0.8rem 2rem;
    }

    .action-button-subtitle {
        font-family: 'Product Sans', sans-serif;
        font-size: 0.75rem;
        font-weight: normal;
        opacity: 0.9;
        margin-top: 0.2rem;
    }

    .illustration-group {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
    }

    .logo-404 {
        width: min(25rem, 80vw);
        height: auto;
        filter: drop-shadow(8px 8px 0 #0002);
    }
</style>

<Base lang={lang} title={t.notFound.title}>
    <section id="hero" class="hero-404-section">
        <div id="binary-art"></div>
        <div class="h-stack-404">
            <div class="hero-content v-stack content-wrapper">
                <div class="text title-text">
                    <h1>404</h1>
                    <h3>{t.notFound.subtitle}</h3>
                </div>

                <div class="card large exception-card">
                    <pre
                        class="code-block"><code><span class="kw">await</span> findPage(<span class="str">"<span id="requested-url">/missing-page</span>"</span>)
<span class="kw">throw new</span> RouteNotFoundError()</code></pre>
                    <a class="button large primary action-button" href={routePath(lang)} role="button">
                        <span>cd /{lang}</span>
                        <span class="action-button-subtitle">{t.notFound.home}</span>
                    </a>
                </div>
            </div>

            <div class="illustration-group">
                <img src={devfestLogoSvg.src} alt={t.site.title} class="logo-404" />
            </div>
        </div>

        <script>
            import { BinaryGrid } from '@/lib/client/binary-art-10y'

            const urlElement = document.getElementById('requested-url')
            if (urlElement) {
                urlElement.textContent = window.location.pathname
            }

            const $binaryArtContainer = document.getElementById('binary-art')!
            new BinaryGrid($binaryArtContainer, {
                cellSize: 32,
                fontSize: 16,
                fontFamily: "'Roboto Mono', 'Courier New', monospace",
                updateInterval: 10,
                samplingRate: 0.005,
                colors: {
                    base: '#cccccc',
                    bg: '#f0f2f5',
                    highlight: '#999999',
                },
            })
        </script>
    </section>
</Base>
