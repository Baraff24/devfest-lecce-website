---
import iconEmail from '@/assets/icons/email.svg?raw'
import iconLinkedin from '@/assets/icons/linkedin.svg?raw'
import { content, eventLinks, routePath, type Lang } from '@/lib/astro/i18n'

// The "<Fragment set:html={...} />" syntax is used to inline the raw SVG from the file,
// this cannot be done with a component because the module must be imported statically
// due to an Astro limitation (itself due to a Vite module resolution limitation).

type Props = {
    lang: Lang
}

const { lang } = Astro.props
const t = content[lang]
---

<footer>
    <div class="wide v-stack">
        <h4>{t.footer.social}</h4>
        <div class="h-flex-wrap">
            <a href={eventLinks.email} target="_blank" rel="noopener noreferrer" aria-label="Email">
                <Fragment set:html={iconEmail} />
            </a>
            <a href={eventLinks.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                <Fragment set:html={iconLinkedin} />
            </a>
        </div>
    </div>
    <div class="v-stack">
        <h4>{t.footer.about}</h4>
        <div class="text">
            <a href={routePath(lang, 'about')}>{t.nav.about}</a>
        </div>
        <div class="text">
            <a href={eventLinks.gdg} target="_blank" rel="noopener noreferrer">{t.footer.gdgLecce}</a>
        </div>
        <div class="text">
            <a href={eventLinks.gdgGlobal} target="_blank" rel="noopener noreferrer">{t.footer.gdg}</a>
        </div>
        <div class="text">
            <a href={eventLinks.devfest} target="_blank" rel="noopener noreferrer">{t.footer.devfest}</a>
        </div>
    </div>
    <div class="v-stack">
        <h4>{t.footer.community}</h4>
        <div class="text">
            <a href={eventLinks.gdg} target="_blank" rel="noopener noreferrer">{t.footer.gdgPlatform}</a>
        </div>
        <div class="text">
            <a href={eventLinks.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
        <div class="text">
            <a href={eventLinks.email}>{t.common.contactUs}</a>
        </div>
    </div>
    <div class="v-stack">
        <h4>{t.footer.resources}</h4>
        <div class="text">
            <a href={routePath(lang, 'code-of-conduct')}>{t.footer.codeOfConduct}</a>
        </div>
        <div class="text">
            <a href={routePath(lang, 'faq')}>{t.footer.faq}</a>
        </div>
        <div class="text">
            <span class="disabled-footer-link">{t.common.viewCfp}</span>
        </div>
    </div>
    <div class="wide center copy-right">
        <div class="text">
            <p>
                {t.footer.madeBy}
                <br />
                <span style="font-family: sans-serif;">&copy;</span>
                {t.footer.copyright}
            </p>
        </div>
    </div>
</footer>
