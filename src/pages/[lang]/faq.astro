---
import Base from '@/layouts/Base.astro'
import { content, defaultLang, eventLinks, isLang, localizedStaticPaths, type Lang } from '@/lib/astro/i18n'

export const getStaticPaths = localizedStaticPaths

const lang = isLang(Astro.params.lang) ? (Astro.params.lang as Lang) : defaultLang
const t = content[lang]
---

<Base lang={lang} title={t.faq.title}>
    <section>
        <div class="card large">
            <div class="text">
                <h1>{t.faq.title}</h1>
                <p>{t.faq.intro}</p>
                {
                    t.faq.items.map(item => (
                        <>
                            <h4>{item.q}</h4>
                            <p>{item.a}</p>
                        </>
                    ))
                }
                <p>
                    <a href={eventLinks.email}>{t.common.contactUs}</a>
                </p>
            </div>
        </div>
    </section>
</Base>
