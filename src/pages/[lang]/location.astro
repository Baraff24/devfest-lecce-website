---
import Base from '@/layouts/Base.astro'
import { Icon } from 'astro-icon/components'
import { content, defaultLang, eventLinks, isLang, localizedStaticPaths, type Lang } from '@/lib/astro/i18n'

export const getStaticPaths = localizedStaticPaths

const lang = isLang(Astro.params.lang) ? (Astro.params.lang as Lang) : defaultLang
const t = content[lang]

const lecceMapsUrl = eventLinks.directions
const lecceOpenStreetMap =
    'https://www.openstreetmap.org/export/embed.html?bbox=18.1585%2C40.3538%2C18.1735%2C40.3628&layer=mapnik&marker=40.35826%2C18.16623'
---

<Base lang={lang} title={t.location.title}>
    <section id="location-hero">
        <div class="location-hero-content">
            <div class="location-text-container">
                <div class="location-text">
                    <h1>{t.location.heroTitle}</h1>
                    <p class="location-subtitle">{t.location.subtitle}</p>
                    <div class="location-badge">
                        <Icon name="mdi:map-marker" />
                        <div class="badge-text">
                            <h3>{t.location.venueName}</h3>
                            <p>{t.location.venueAddress}</p>
                        </div>
                    </div>
                    <a
                        class="primary large"
                        href={lecceMapsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        role="button"
                    >
                        <Icon name="mdi:map-search" />
                        {t.location.mapCta}
                    </a>
                </div>
            </div>
            <div class="location-visual">
                <div class="location-map-preview">
                    <iframe title={t.location.mapTitle} src={lecceOpenStreetMap} loading="lazy"></iframe>
                    <div class="map-preview-chip">
                        <Icon name="mdi:map-marker" />
                        <span>{t.location.venueName}</span>
                    </div>
                    <a
                        class="map-preview-link button square"
                        href={lecceMapsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={t.location.mapCta}
                    >
                        <Icon name="mdi:open-in-new" />
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section id="location-info">
        <h2>{t.location.infoTitle}</h2>
        <div class="card large">
            <div class="text">
                {t.location.info.map(paragraph => <p>{paragraph}</p>)}
            </div>
        </div>
    </section>

    <section id="location-map">
        <div class="map-list">
            <div class="wide">
                <h2>{t.location.findUs}</h2>
            </div>
            <div class="map-item">
                <div class="title">
                    <span>{t.location.mapTitle}</span>
                    <div class="actions">
                        <a href={lecceMapsUrl} class="button flat square" target="_blank" rel="noopener noreferrer">
                            <Icon name="mdi:directions" />
                        </a>
                    </div>
                </div>
                <div class="content">
                    <div class="timestamp">{t.location.venueAddress}</div>
                    <div class="text">
                        <p>{t.location.mapText}</p>
                    </div>
                    <div class="map-container">
                        <iframe class="embedded-map" title={t.location.mapTitle} src={lecceOpenStreetMap} loading="lazy"
                        ></iframe>
                        <a class="primary" href={lecceMapsUrl} target="_blank" rel="noopener noreferrer" role="button">
                            <Icon name="mdi:open-in-new" />
                            {t.location.mapCta}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="location-directions">
        <h2>{t.location.directionsTitle}</h2>
        <div class="directions-list">
            <div class="card large direction-card">
                <Icon name="mdi:train" />
                <h3>{t.location.trainTitle}</h3>
                <div class="text">
                    <p>{t.location.train}</p>
                </div>
            </div>

            <div class="card large direction-card">
                <Icon name="mdi:airplane" />
                <h3>{t.location.planeTitle}</h3>
                <div class="text">
                    <p>{t.location.plane}</p>
                </div>
            </div>

            <div class="card large direction-card">
                <Icon name="mdi:car" />
                <h3>{t.location.carTitle}</h3>
                <div class="text">
                    <p>{t.location.car}</p>
                </div>
            </div>
        </div>
    </section>
</Base>
