---
import Redirect from '@/layouts/Redirect.astro'
import { defaultLang, isLang, localizedStaticPaths, routePath, type Lang } from '@/lib/astro/i18n'

export const getStaticPaths = localizedStaticPaths

const lang = isLang(Astro.params.lang) ? (Astro.params.lang as Lang) : defaultLang
---

<Redirect to={routePath(lang, 'about')} />
