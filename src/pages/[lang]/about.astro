---
import Base from '@/layouts/Base.astro'
import { Icon } from 'astro-icon/components'
import martinoScarciaImage from '@/assets/team/martino-scarcia.jpg'
import raffaeleGriecoImage from '@/assets/team/raffaele-grieco.jpeg'
import { content, defaultLang, eventLinks, isLang, localizedStaticPaths, type Lang } from '@/lib/astro/i18n'

export const getStaticPaths = localizedStaticPaths

const lang = isLang(Astro.params.lang) ? (Astro.params.lang as Lang) : defaultLang
const t = content[lang]
const organizerImages = {
    'martino-scarcia': martinoScarciaImage,
    'raffaele-grieco': raffaeleGriecoImage,
} as const
---

<Base lang={lang} title={t.about.title}>
    <section id="about" class="wide">
        <div class="about-page">
            <div class="wide about-hero">
                <h1>{t.about.title}</h1>
                <div class="text">
                    <p>{t.about.intro}</p>
                </div>
            </div>

            <div class="event-facts">
                {
                    t.about.facts.map(fact => (
                        <div class="card large">
                            <span>{fact.label}</span>
                            <strong>{fact.value}</strong>
                        </div>
                    ))
                }
            </div>

            <div class="about-section-list">
                {
                    t.about.sections.map(section => (
                        <div class="card large about-section-card">
                            <div class="text">
                                <h2>{section.title}</h2>
                                <p>{section.text}</p>
                            </div>
                        </div>
                    ))
                }
            </div>

            <div class="about-organizers-block">
                <div class="section-heading">
                    <h2>{t.about.organizersTitle}</h2>
                    <p>{t.about.organizersIntro}</p>
                </div>
                <div class="people-list about-organizer-list">
                    {
                        t.about.organizers.map(organizer => {
                            const image = organizerImages[organizer.id as keyof typeof organizerImages]

                            return (
                                <a
                                    class="person organizer-card about-organizer-card"
                                    href={organizer.profileUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <div class="picture">
                                        <img src={image.src} alt={organizer.name} loading="lazy" />
                                    </div>
                                    <div class="about-organizer-copy">
                                        <h3>{organizer.name}</h3>
                                        <p>{organizer.role}</p>
                                        <span>{[organizer.title, organizer.company].filter(Boolean).join(' @ ')}</span>
                                    </div>
                                </a>
                            )
                        })
                    }
                </div>
            </div>

            <div class="about-activities-block">
                <div class="section-heading">
                    <h2>{t.about.activitiesTitle}</h2>
                </div>

                <div class="activity-grid">
                    {
                        t.about.activities.map(activity => (
                            <div class="card activity-card">
                                <Icon name="mdi:sparkles-outline" />
                                <div class="text">
                                    <h3>{activity.title}</h3>
                                    <p>{activity.text}</p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>

            <div class="card large about-contact-card">
                <div class="text">
                    <h2>{t.footer.contact}</h2>
                    <p>info@gdglecce.it</p>
                </div>
                <a class="large primary" href={eventLinks.email} role="button">
                    <Icon name="mdi:email-outline" />
                    {t.common.contactUs}
                </a>
            </div>
        </div>
    </section>
</Base>
