---
import Base from '@/layouts/Base.astro'
import { Icon } from 'astro-icon/components'

import devfestLogoSvg from '@/assets/devfest-logo.svg'
import topicsImage from '@/assets/topics.png'
import { content, defaultLang, eventLinks, isLang, localizedStaticPaths, type Lang } from '@/lib/astro/i18n'

export const getStaticPaths = localizedStaticPaths

const lang = isLang(Astro.params.lang) ? (Astro.params.lang as Lang) : defaultLang
const t = content[lang]
---

<Base lang={lang}>
    <section id="hero">
        <div id="binary-art"></div>
        <div class="h-stack">
            <div class="hero-content v-stack">
                <div class="text">
                    <h1>{t.home.hero.title}</h1>
                    <h3>{t.home.hero.subtitle}</h3>
                    <p class="motto">{t.home.hero.motto}</p>
                </div>
                <div class="hero-actions h-flex-wrap">
                    <a
                        class="primary large"
                        href={eventLinks.gdg}
                        target="_blank"
                        rel="noopener noreferrer"
                        role="button"
                    >
                        <Icon name="mdi:bell-outline" />
                        {t.home.hero.primaryCta}
                    </a>
                    <a class="large" href={eventLinks.cfp} target="_blank" rel="noopener noreferrer" role="button">
                        <Icon name="mdi:microphone-outline" />
                        {t.home.hero.secondaryCta}
                    </a>
                </div>
            </div>
            <img class="hero-image hero-logo" src={devfestLogoSvg.src} alt={t.home.hero.logoAlt} />
        </div>
        <script>
            import { BinaryGrid } from '@/lib/client/binary-art-10y'
            const $binaryArtContainer = document.getElementById('binary-art')!
            new BinaryGrid($binaryArtContainer, {
                cellSize: 32,
                fontSize: 16,
                fontFamily: "'Roboto Mono', 'Courier New', monospace",
                updateInterval: 10,
                samplingRate: 0.005,
                colors: {
                    base: '#7cbdff',
                    bg: '#a5d2ff',
                    highlight: '#579ee5',
                },
            })
        </script>
    </section>

    <section id="tickets">
        <h2>{t.home.tickets.title}</h2>
        <div class="card large">
            <div class="text">
                <p>{t.home.tickets.body}</p>
            </div>
            <a class="large" href={eventLinks.gdg} target="_blank" rel="noopener noreferrer" role="button">
                <Icon name="mdi:account-group" />
                {t.home.tickets.cta}
            </a>
        </div>
    </section>

    <section id="cfp">
        <h2>{t.home.cfp.title}</h2>
        <div class="card large" data-diagonal-message={t.home.cfp.badge}>
            <div class="text">
                {t.home.cfp.body.map(paragraph => <p>{paragraph}</p>)}
            </div>
            <a class="large" href={eventLinks.cfp} target="_blank" rel="noopener noreferrer" role="button">
                {t.home.cfp.cta}
            </a>
        </div>
    </section>

    <section id="stats">
        <div class="stats-layouts">
            <div class="stats-card card large">
                <div class="text">
                    <h2>{t.home.intro.title}</h2>
                    {t.home.intro.body.map(paragraph => <p>{paragraph}</p>)}
                </div>
                <a class="large" href={eventLinks.gdg} target="_blank" rel="noopener noreferrer" role="button">
                    <Icon name="material-symbols:groups-rounded" />
                    {t.home.intro.cta}
                </a>
            </div>
            {
                t.home.stats.map(stat => (
                    <div class="card large">
                        <div class="v-stack center">
                            <div class="text-large">{stat.value}</div>
                            <div class="text-center">{stat.label}</div>
                        </div>
                    </div>
                ))
            }
        </div>
    </section>

    <section id="topics">
        <h2>{t.home.topicsTitle}</h2>
        <div class="topic-layout">
            <div class="card large tight">
                <img src={topicsImage.src} alt={t.home.topicsTitle} />
            </div>
            <div class="topic-grid">
                {
                    t.home.topics.map(topic => (
                        <div class="card topic-card">
                            <strong>{topic}</strong>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section id="sponsors">
        <h2>{t.home.partners.title}</h2>
        <div class="card large">
            <div class="text">
                <p>{t.home.partners.body}</p>
            </div>
            <a class="large" href={eventLinks.email} role="button">
                <Icon name="mdi:email-outline" />
                {t.home.partners.cta}
            </a>
        </div>
    </section>
</Base>
