---
import Base from '@/layouts/Base.astro'
import { content, defaultLang, eventLinks, isLang, localizedStaticPaths, type Lang } from '@/lib/astro/i18n'

export const getStaticPaths = localizedStaticPaths

const lang = isLang(Astro.params.lang) ? (Astro.params.lang as Lang) : defaultLang
const t = content[lang]
---

<Base lang={lang} title={t.coc.title}>
    <section>
        <div class="card large">
            <div class="text">
                <h1>{t.coc.title}</h1>
                {
                    t.coc.sections.map(section => (
                        <>
                            <h3>{section.title}</h3>
                            {section.body.map(paragraph => (
                                <p>{paragraph}</p>
                            ))}
                        </>
                    ))
                }
                <div class="grid-centered">
                    <a class="large" role="button" href={eventLinks.email}>
                        {t.common.contactUs}
                    </a>
                </div>
            </div>
        </div>
    </section>
</Base>
