---
import Base from '@/layouts/Base.astro'
import { content, defaultLang, isLang, localizedStaticPaths, routePath, type Lang } from '@/lib/astro/i18n'
import {
    getTalkDurationLabel,
    getTalkTrackId,
    getTalkTrackLabel,
    SPEAKERS,
    TALKS,
    type Speaker,
    type Talk,
} from '@/lib/astro/sessionize'

export const getStaticPaths = localizedStaticPaths

const lang = isLang(Astro.params.lang) ? (Astro.params.lang as Lang) : defaultLang
const t = content[lang]
const visibleSpeakers = [...SPEAKERS].sort((a, b) =>
    `${a.firstName} ${a.lastName}`.localeCompare(`${b.firstName} ${b.lastName}`, lang),
)
const talksBySpeaker = new Map(
    visibleSpeakers.map(speaker => [
        speaker.id,
        TALKS.filter(talk => talk.speakers.some(talkSpeaker => talkSpeaker.id === speaker.id)),
    ]),
)

const getSpeakerName = (speaker: Speaker) => `${speaker.firstName} ${speaker.lastName}`.trim()
const getSpeakerInitials = (speaker: Speaker) =>
    [speaker.firstName, speaker.lastName]
        .filter(Boolean)
        .map(part => part[0])
        .join('')
        .slice(0, 2)
        .toUpperCase()
const getSpeakerSessionHref = (talk: Talk) => `${routePath(lang, 'sessions')}/${talk.id}`
---

<Base lang={lang} title={t.speakers.title}>
    <section class="wide">
        <div class="announcement-page">
            <div class="wide">
                <h1>{t.speakers.title}</h1>
            </div>
            <div class="card large announcement-card">
                <div class="text">
                    <p>{t.speakers.body}</p>
                </div>
            </div>
            {
                visibleSpeakers.length > 0 ? (
                    <div class="speaker-directory" aria-labelledby="speaker-directory-title">
                        <div class="section-heading">
                            <span class="section-kicker">
                                {visibleSpeakers.length} {t.speakers.lineupTitle.toLowerCase()}
                            </span>
                            <div class="text">
                                <h2 id="speaker-directory-title">{t.speakers.lineupTitle}</h2>
                                <!--<p>{t.speakers.lineupIntro}</p>-->
                            </div>
                        </div>

                        <div class="speaker-grid">
                            {visibleSpeakers.map(speaker => {
                                const speakerTalks = talksBySpeaker.get(speaker.id) ?? []
                                const primaryTalk = speakerTalks[0]
                                const primaryTrack = primaryTalk ? getTalkTrackLabel(primaryTalk) : 'Intermediate'

                                return (
                                    <article
                                        class={`card large program-card speaker-lineup-card schedule-track-${getTalkTrackId(primaryTrack)}`}
                                    >
                                        <div class="program-card-badges">
                                            <span class="program-chip track-chip">{primaryTrack}</span>
                                        </div>

                                        <div class="program-card-main">
                                            <div class="program-card-media speaker-card-media">
                                                <div class="program-avatar">
                                                    {speaker.profilePicture ? (
                                                        <img
                                                            src={speaker.profilePicture}
                                                            alt={getSpeakerName(speaker)}
                                                            loading="lazy"
                                                        />
                                                    ) : (
                                                        <div class="speaker-card-initials" aria-hidden="true">
                                                            {getSpeakerInitials(speaker)}
                                                        </div>
                                                    )}
                                                </div>
                                            </div>
                                            <div class="text program-card-copy">
                                                <h2>{getSpeakerName(speaker)}</h2>
                                                {speaker.tagLine && <p class="speaker-tagline">{speaker.tagLine}</p>}
                                                <p class="speaker-bio-preview">{speaker.bio || t.speakers.bioFallback}</p>
                                            </div>
                                        </div>

                                        {speakerTalks.length > 0 && (
                                            <div class="program-card-links">
                                                <strong>
                                                    {speakerTalks.length === 1
                                                        ? t.speakers.sessionLabel
                                                        : t.speakers.sessionsLabel}
                                                </strong>
                                                {speakerTalks.map(talk => {
                                                    const track = getTalkTrackLabel(talk)
                                                    const duration = getTalkDurationLabel(talk)

                                                    return (
                                                        <a
                                                            class={`program-card-action secondary schedule-track-${getTalkTrackId(track)}`}
                                                            href={getSpeakerSessionHref(talk)}
                                                            aria-label={`${t.speakers.openSession}: ${talk.title}`}
                                                        >
                                                            <span>{track}</span>
                                                            <strong>{talk.title}</strong>
                                                            {duration && <em>{duration}</em>}
                                                        </a>
                                                    )
                                                })}
                                            </div>
                                        )}
                                    </article>
                                )
                            })}
                        </div>
                    </div>
                ) : (
                    <div class="topic-grid">
                        {t.speakers.cards.map(card => (
                            <div class="card topic-card">
                                <strong>{card}</strong>
                            </div>
                        ))}
                    </div>
                )
            }
        </div>
    </section>
</Base>
