---
import devfestLogoSvg from '@/assets/devfest-logo.svg'
import '@/styles/navbar.css'
import { Icon } from 'astro-icon/components'
import { content, langLabels, languages, routePath, switchLangPath, type Lang } from '@/lib/astro/i18n'

type Props = {
    lang: Lang
}

const { lang } = Astro.props
const t = content[lang]

const navItems = [
    { href: routePath(lang, 'speakers'), label: t.nav.speakers },
    { href: routePath(lang, 'schedule'), label: t.nav.schedule },
    { href: routePath(lang, 'location'), label: t.nav.location },
    { href: routePath(lang, 'about'), label: t.nav.about },
    // Sezioni tenute nel codice ma nascoste dalla navigazione per DevFest Lecce 2026.
    // { href: routePath(lang, 'news'), label: t.nav.news },
]
---

<script>
    document.body.classList.toggle('not-on-top', window.scrollY > 0)
    window.addEventListener('scroll', () => {
        document.body.classList.toggle('not-on-top', window.scrollY > 0)
    })
</script>
<header>
    <input id="mobile-nav-trigger" type="checkbox" class="hide" autocomplete="off" />
    <nav>
        <div class="nav-item">
            <a href={routePath(lang)}>
                <img src={devfestLogoSvg.src} alt={t.site.title} />
                <!--    {t.site.title}-->
            </a>
        </div>
        <div class="spacer"></div>
        {
            navItems.map(item => (
                <div class="nav-item desktop-only">
                    <a href={item.href}>{item.label}</a>
                </div>
            ))
        }
        <div class="nav-item desktop-only language-switcher" aria-label="Language selector">
            {
                languages.map(locale => (
                    <a
                        href={switchLangPath(Astro.url.pathname, locale)}
                        class:list={{ active: locale === lang }}
                        aria-current={locale === lang ? 'page' : undefined}
                        aria-label={langLabels[locale]}
                    >
                        {locale.toUpperCase()}
                    </a>
                ))
            }
        </div>
        <div class="nav-item mobile-only">
            <label for="mobile-nav-trigger">
                <Icon name="material-symbols:menu" />
            </label>
        </div>
    </nav>
    <div id="mobile-nav" class="mobile-only">
        <div class="nav-item">
            <a href={routePath(lang)}>
                <img src={devfestLogoSvg.src} alt={t.site.title} />
                <!--    {t.site.title}-->
            </a>

            <label for="mobile-nav-trigger">
                <Icon name="material-symbols:close" />
            </label>
        </div>
        <div class="divider"></div>
        {
            navItems.map(item => (
                <div class="nav-item">
                    <a href={item.href}>{item.label}</a>
                </div>
            ))
        }
        <div class="nav-item language-switcher">
            {
                languages.map(locale => (
                    <a
                        href={switchLangPath(Astro.url.pathname, locale)}
                        class:list={{ active: locale === lang }}
                        aria-current={locale === lang ? 'page' : undefined}
                        aria-label={langLabels[locale]}
                    >
                        {locale.toUpperCase()}
                    </a>
                ))
            }
        </div>
    </div>
</header>
