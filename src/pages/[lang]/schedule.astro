---
import Base from '@/layouts/Base.astro'
import { content, defaultLang, isLang, localizedStaticPaths, routePath, type Lang } from '@/lib/astro/i18n'
import {
    getTalkDurationLabel,
    getTalkTrackId,
    getTalkTrackLabel,
    SESSION_TRACKS,
    TALKS,
    type SessionTrack,
    type Speaker,
    type Talk,
} from '@/lib/astro/sessionize'

export const getStaticPaths = localizedStaticPaths

const lang = isLang(Astro.params.lang) ? (Astro.params.lang as Lang) : defaultLang
const t = content[lang]

const getSpeakerName = (speaker: Speaker) => `${speaker.firstName} ${speaker.lastName}`.trim()
type ScheduleSession = {
    talk: Talk
    track: SessionTrack
    trackId: string
    sessionType: 'talk' | 'workshop'
    duration: string
}

type ScheduleCell = {
    track: SessionTrack
    trackId: string
    sessions: ScheduleSession[]
}

type ScheduleRow = {
    key: string
    label: string
    subLabel: string
    cells: ScheduleCell[]
}

const getSessionType = (talk: Talk): ScheduleSession['sessionType'] =>
    talk.sessionFormat.toLowerCase().includes('workshop') ? 'workshop' : 'talk'

const acceptedTalks = [...TALKS]
    .map<ScheduleSession>(talk => {
        const track = getTalkTrackLabel(talk)

        return {
            talk,
            track,
            trackId: getTalkTrackId(track),
            sessionType: getSessionType(talk),
            duration: getTalkDurationLabel(talk),
        }
    })
    .sort(
        (a, b) =>
            SESSION_TRACKS.indexOf(a.track) - SESSION_TRACKS.indexOf(b.track) ||
            a.talk.title.localeCompare(b.talk.title, lang),
    )
const talksByTrack = SESSION_TRACKS.map(track => ({
    track,
    id: getTalkTrackId(track),
    title: track,
    description: t.schedule.trackDescriptions[track],
    sessions: acceptedTalks.filter(item => item.track === track),
}))
const getSessionCountLabel = (count: number) =>
    count === 1 ? t.schedule.sessionCountSingular : t.schedule.sessionCountPlural
const getSessionDetailHref = (talk: Talk) => `${routePath(lang, 'sessions')}/${talk.id}`

const formatScheduleTime = (scheduledStart: string) => {
    const date = new Date(scheduledStart)
    if (Number.isNaN(date.getTime())) {
        return scheduledStart
    }

    return new Intl.DateTimeFormat(lang === 'it' ? 'it-IT' : 'en-GB', {
        hour: '2-digit',
        minute: '2-digit',
    }).format(date)
}

const getScheduleTimeKey = (scheduledStart: string) => {
    const date = new Date(scheduledStart)
    if (Number.isNaN(date.getTime())) {
        return scheduledStart
    }

    return String(date.getTime())
}

const buildPlanningRows = (sessions: ScheduleSession[]): ScheduleRow[] => {
    const sessionsByTrack = SESSION_TRACKS.map(track => ({
        track,
        trackId: getTalkTrackId(track),
        sessions: sessions.filter(session => session.track === track),
    }))
    const rowCount = Math.max(0, ...sessionsByTrack.map(group => group.sessions.length))

    return Array.from({ length: rowCount }, (_, index) => ({
        key: `planning-${index + 1}`,
        label: t.schedule.slotLabel.replace('{number}', String(index + 1)),
        subLabel: t.schedule.unscheduledNote,
        cells: sessionsByTrack.map(group => ({
            track: group.track,
            trackId: group.trackId,
            sessions: group.sessions[index] ? [group.sessions[index]] : [],
        })),
    }))
}

const scheduledSessions = acceptedTalks.filter(session => session.talk.scheduledStart)
const unscheduledSessions = acceptedTalks.filter(session => !session.talk.scheduledStart)
const hasTimedAgenda = scheduledSessions.length > 0
const timedRows: ScheduleRow[] = hasTimedAgenda
    ? [...new Set(scheduledSessions.map(session => getScheduleTimeKey(session.talk.scheduledStart)))]
          .sort((a, b) => Number(a) - Number(b))
          .map(timeKey => {
              const rowSessions = scheduledSessions.filter(
                  session => getScheduleTimeKey(session.talk.scheduledStart) === timeKey,
              )
              const firstSession = rowSessions[0]

              return {
                  key: `time-${timeKey}`,
                  label: firstSession ? formatScheduleTime(firstSession.talk.scheduledStart) : timeKey,
                  subLabel: t.schedule.timedSlotLabel,
                  cells: SESSION_TRACKS.map(track => ({
                      track,
                      trackId: getTalkTrackId(track),
                      sessions: rowSessions.filter(session => session.track === track),
                  })),
              }
          })
    : []
const scheduleRows = hasTimedAgenda
    ? [...timedRows, ...buildPlanningRows(unscheduledSessions)]
    : buildPlanningRows(acceptedTalks)
const talkCount = acceptedTalks.filter(session => session.sessionType === 'talk').length
const workshopCount = acceptedTalks.filter(session => session.sessionType === 'workshop').length
---

<Base lang={lang} title={t.schedule.title}>
    <section id="schedule" class="wide">
        <div class="announcement-page">
            <div class="wide">
                <h1>{t.schedule.title}</h1>
            </div>
            {
                acceptedTalks.length > 0 ? (
                    <div
                        class="session-directory schedule-board-directory"
                        aria-labelledby="session-directory-title"
                        data-schedule-directory
                    >
                        <div class="section-heading schedule-board-heading">
                            <span class="section-kicker">{t.schedule.dayLabel}</span>
                            <div class="text">
                                <h2 id="session-directory-title">{t.schedule.boardTitle}</h2>
                                <p>{hasTimedAgenda ? t.schedule.boardIntro : t.schedule.boardPendingIntro}</p>
                            </div>
                        </div>

                        <div class="schedule-filter-panel schedule-board-controls" aria-label={t.schedule.filters.label}>
                            <div class="schedule-filter-group">
                                <div class="schedule-filter-copy">
                                    <strong>{t.schedule.filters.title}</strong>
                                    <span data-schedule-filter-status aria-live="polite">
                                        {t.schedule.filters.allStatus}
                                    </span>
                                </div>
                                <div class="schedule-filter-buttons" aria-label={t.schedule.filters.label}>
                                    <button
                                        class="schedule-filter-button is-active"
                                        type="button"
                                        data-track-filter="all"
                                        data-status={t.schedule.filters.allStatus}
                                        aria-pressed="true"
                                    >
                                        <span>{t.schedule.filters.all}</span>
                                        <strong>{acceptedTalks.length}</strong>
                                    </button>
                                    {talksByTrack.map(group => (
                                        <button
                                            class={`schedule-filter-button schedule-track-${group.id}`}
                                            type="button"
                                            data-track-filter={group.track}
                                            data-status={t.schedule.filters.trackStatus.replace('{track}', group.title)}
                                            aria-pressed="false"
                                        >
                                            <span>{group.title}</span>
                                            <strong>{group.sessions.length}</strong>
                                        </button>
                                    ))}
                                </div>
                            </div>

                            <div class="schedule-filter-group">
                                <div class="schedule-filter-copy">
                                    <strong>{t.schedule.typeFilters.title}</strong>
                                    <span>{t.schedule.typeFilters.intro}</span>
                                </div>
                                <div class="schedule-filter-buttons schedule-type-buttons" aria-label={t.schedule.typeFilters.label}>
                                    <button
                                        class="schedule-filter-button is-active"
                                        type="button"
                                        data-type-filter="all"
                                        data-status={t.schedule.typeFilters.allStatus}
                                        aria-pressed="true"
                                    >
                                        <span>{t.schedule.typeFilters.all}</span>
                                        <strong>{acceptedTalks.length}</strong>
                                    </button>
                                    <button
                                        class="schedule-filter-button"
                                        type="button"
                                        data-type-filter="talk"
                                        data-status={t.schedule.typeFilters.talkStatus}
                                        aria-pressed="false"
                                    >
                                        <span>{t.schedule.typeFilters.talk}</span>
                                        <strong>{talkCount}</strong>
                                    </button>
                                    <button
                                        class="schedule-filter-button schedule-track-workshop"
                                        type="button"
                                        data-type-filter="workshop"
                                        data-status={t.schedule.typeFilters.workshopStatus}
                                        aria-pressed="false"
                                    >
                                        <span>{t.schedule.typeFilters.workshop}</span>
                                        <strong>{workshopCount}</strong>
                                    </button>
                                </div>
                            </div>
                        </div>

                        {!hasTimedAgenda && <p class="schedule-board-note">{t.schedule.timedUnavailableText}</p>}

                        <div class="schedule-board-shell">
                            <p id="schedule-scroll-hint" class="schedule-scroll-hint">
                                {t.schedule.scrollHint}
                            </p>
                            <div class="schedule-board-scroll" aria-describedby="schedule-scroll-hint">
                                <div class="schedule-board" role="table" aria-label={t.schedule.boardTitle}>
                                    <div class="schedule-board-header" role="row">
                                        <div class="schedule-time-heading" role="columnheader">
                                            {t.schedule.meta.time}
                                        </div>
                                        {talksByTrack.map(column => (
                                            <div
                                                class={`schedule-board-track schedule-track-${column.id}`}
                                                role="columnheader"
                                                data-track-column={column.track}
                                            >
                                                <strong>{column.title}</strong>
                                                <span>
                                                    {column.sessions.length} {getSessionCountLabel(column.sessions.length)}
                                                </span>
                                            </div>
                                        ))}
                                    </div>

                                    <div class="schedule-board-body">
                                        {scheduleRows.map(row => (
                                            <section class="schedule-row" role="row" data-schedule-row>
                                                <div class="schedule-row-time" role="rowheader">
                                                    <strong>{row.label}</strong>
                                                    <span>{row.subLabel}</span>
                                                </div>

                                                {row.cells.map(cell => (
                                            <div
                                                class:list={[
                                                    'schedule-slot',
                                                    `schedule-track-${cell.trackId}`,
                                                    cell.sessions.length > 0 ? 'has-sessions' : 'is-empty',
                                                ]}
                                                role="cell"
                                                data-track-cell={cell.track}
                                            >
                                                {cell.sessions.length > 0 ? (
                                                    cell.sessions.map(session => (
                                                        <a
                                                            id={`session-${session.talk.id}`}
                                                            class="schedule-session-card"
                                                            href={getSessionDetailHref(session.talk)}
                                                            data-session-card
                                                            data-track={session.track}
                                                            data-session-type={session.sessionType}
                                                        >
                                                            <span class="schedule-session-eyebrow">
                                                                {session.sessionType === 'workshop'
                                                                    ? t.schedule.typeFilters.workshop
                                                                    : t.schedule.typeFilters.talk}
                                                            </span>
                                                            <strong class="schedule-session-title">
                                                                {session.talk.title}
                                                            </strong>
                                                            {session.talk.speakers.length > 0 && (
                                                                <span class="schedule-session-speakers">
                                                                    {session.talk.speakers.map(getSpeakerName).join(', ')}
                                                                </span>
                                                            )}
                                                            <span class="schedule-session-meta">
                                                                {session.talk.language && (
                                                                    <span>{session.talk.language}</span>
                                                                )}
                                                                {session.duration && <span>{session.duration}</span>}
                                                                {session.talk.room && <span>{session.talk.room}</span>}
                                                            </span>
                                                        </a>
                                                    ))
                                                ) : (
                                                    <span
                                                        class="schedule-slot-empty"
                                                        data-empty-slot
                                                        aria-label={t.schedule.emptySlot}
                                                    />
                                                )}
                                            </div>
                                        ))}
                                            </section>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                ) : (
                    <div class="topic-grid">
                        {t.schedule.cards.map(card => (
                            <div class="card topic-card">
                                <strong>{card}</strong>
                            </div>
                        ))}
                    </div>
                )
            }
        </div>
    </section>
</Base>

<script>
    const scheduleDirectory = document.querySelector('[data-schedule-directory]')

    if (scheduleDirectory) {
        const trackButtons = [...scheduleDirectory.querySelectorAll<HTMLButtonElement>('[data-track-filter]')]
        const typeButtons = [...scheduleDirectory.querySelectorAll<HTMLButtonElement>('[data-type-filter]')]
        const trackColumns = [...scheduleDirectory.querySelectorAll<HTMLElement>('[data-track-column]')]
        const trackCells = [...scheduleDirectory.querySelectorAll<HTMLElement>('[data-track-cell]')]
        const sessionCards = [...scheduleDirectory.querySelectorAll<HTMLElement>('[data-session-card]')]
        const scheduleRows = [...scheduleDirectory.querySelectorAll<HTMLElement>('[data-schedule-row]')]
        const status = scheduleDirectory.querySelector<HTMLElement>('[data-schedule-filter-status]')
        let selectedTrack = 'all'
        let selectedType = 'all'

        const updateButtons = (buttons: HTMLButtonElement[], activeValue: string, dataKey: 'trackFilter' | 'typeFilter') => {
            buttons.forEach(button => {
                const isActive = button.dataset[dataKey] === activeValue
                button.classList.toggle('is-active', isActive)
                button.setAttribute('aria-pressed', String(isActive))
            })
        }

        const updateStatus = () => {
            if (!status) return

            const trackStatus = trackButtons.find(button => button.dataset.trackFilter === selectedTrack)?.dataset.status ?? ''
            const typeStatus = typeButtons.find(button => button.dataset.typeFilter === selectedType)?.dataset.status ?? ''

            status.textContent = selectedType === 'all' ? trackStatus : `${trackStatus} ${typeStatus}`
        }

        const applyFilters = () => {
            trackColumns.forEach(column => {
                column.hidden = selectedTrack !== 'all' && column.dataset.trackColumn !== selectedTrack
            })

            trackCells.forEach(cell => {
                cell.hidden = selectedTrack !== 'all' && cell.dataset.trackCell !== selectedTrack
            })

            sessionCards.forEach(card => {
                const matchesType = selectedType === 'all' || card.dataset.sessionType === selectedType
                card.hidden = !matchesType
            })

            scheduleRows.forEach(row => {
                const visibleCards = [...row.querySelectorAll<HTMLElement>('[data-session-card]')].some(card => {
                    const parentCell = card.closest<HTMLElement>('[data-track-cell]')
                    return !card.hidden && !parentCell?.hidden
                })
                row.hidden = !visibleCards
            })

            updateButtons(trackButtons, selectedTrack, 'trackFilter')
            updateButtons(typeButtons, selectedType, 'typeFilter')
            updateStatus()
        }

        trackButtons.forEach(button => {
            button.addEventListener('click', () => {
                selectedTrack = button.dataset.trackFilter ?? 'all'
                applyFilters()
            })
        })

        typeButtons.forEach(button => {
            button.addEventListener('click', () => {
                selectedType = button.dataset.typeFilter ?? 'all'
                applyFilters()
            })
        })
    }
</script>
